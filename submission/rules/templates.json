{
 "_doc": "Template-required items checked by regex on the comment-free sources reached from the main file. severity error -> status partial if missing. Add your own per case in work/changes.json 'requirements' (same shape). 'absent': true means the pattern must NOT occur.",
 "*": {
  "required": [
   {
    "id": "G01",
    "desc": "\\title{...} is set",
    "pattern": "\\\\title\\s*(\\[[^\\]]*\\])?\\s*\\{\\s*[^}\\s]",
    "severity": "warning",
    "only_if": "\\\\maketitle"
   },
   {
    "id": "G02",
    "desc": "no unresolved placeholders (TODO/XXX/??/<insert>)",
    "pattern": "(TODO|FIXME|XXX|\\?\\?\\?|<insert|\\[citation needed\\])",
    "absent": true,
    "severity": "warning"
   }
  ]
 },
 "elsarticle": {
  "required": [
   {
    "id": "ELS01",
    "desc": "\\journal{...} set (elsarticle)",
    "pattern": "\\\\journal\\s*\\{\\s*[^}\\s]"
   },
   {
    "id": "ELS02",
    "desc": "frontmatter environment",
    "pattern": "\\\\begin\\{frontmatter\\}"
   },
   {
    "id": "ELS03",
    "desc": "abstract inside frontmatter",
    "pattern": "\\\\begin\\{frontmatter\\}.*\\\\begin\\{abstract\\}.*\\\\end\\{frontmatter\\}"
   },
   {
    "id": "ELS04",
    "desc": "keyword environment",
    "pattern": "\\\\begin\\{keyword\\}",
    "severity": "warning"
   }
  ]
 },
 "IEEEtran": {
  "required": [
   {
    "id": "IEEE01",
    "desc": "\\maketitle",
    "pattern": "\\\\maketitle"
   },
   {
    "id": "IEEE02",
    "desc": "abstract environment",
    "pattern": "\\\\begin\\{abstract\\}"
   },
   {
    "id": "IEEE03",
    "desc": "IEEEkeywords environment",
    "pattern": "\\\\begin\\{IEEEkeywords\\}",
    "severity": "warning"
   },
   {
    "id": "IEEE04",
    "desc": "authors via \\IEEEauthorblockN (conference) or \\author",
    "pattern": "\\\\author\\s*\\{",
    "severity": "warning"
   }
  ]
 },
 "llncs": {
  "required": [
   {
    "id": "LNCS01",
    "desc": "\\institute{...}",
    "pattern": "\\\\institute\\s*\\{"
